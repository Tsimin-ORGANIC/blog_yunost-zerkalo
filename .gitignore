# Hugo 构建产物
public/
resources/
.hugo_build.lock

# 博客助手打包产物
blog-app/build/
blog-app/dist/
blog-app/*.spec

# Python 缓存（上传脚本用 git add -A，必须挡住这些）
__pycache__/
*.pyc

# 配色面板的自动备份（带时间戳，只留在本机）
assets/scss/.theme-backups/

# 系统文件
.DS_Store
Thumbs.db

# Hugo 构建时自动生成的编辑器提示文件（含本机路径，不该进仓库）
assets/jsconfig.json
